AthalarIconEditorRow < Panel
  height: 30
  margin-top: 2

  CheckBox
    id: visible
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    width: 18
    height: 18

  Label
    id: name
    anchors.left: visible.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 3
    width: 105
    font: verdana-11px-rounded
    text: Icon

  SpinBox
    id: x
    anchors.left: name.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    width: 62
    height: 20
    minimum: 0
    maximum: 2500
    step: 1
    editable: true

  SpinBox
    id: y
    anchors.left: x.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    width: 62
    height: 20
    minimum: 0
    maximum: 2500
    step: 1
    editable: true

  Button
    id: apply
    anchors.left: y.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 5
    width: 48
    height: 20
    text: Apply

AthalarIconEditorWindow < MainWindow
  !text: tr('Icon Editor')
  size: 380 340
  @onEscape: self:hide()

  Label
    id: help
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    height: 30
    text-align: center
    font: verdana-11px-rounded
    color: #9dd1ce
    text: Move icons or edit X / Y, then Save Current

  Label
    id: headers
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: help.bottom
    height: 18
    font: verdana-11px-rounded
    text: Show  Name                         X          Y

  ScrollablePanel
    id: list
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: headers.bottom
    anchors.bottom: separator.top
    margin-top: 2
    margin-bottom: 8
    vertical-scrollbar: listScrollBar
    layout: verticalBox

  VerticalScrollBar
    id: listScrollBar
    anchors.top: list.top
    anchors.bottom: list.bottom
    anchors.right: list.right
    step: 20
    pixels-scroll: true

  HorizontalSeparator
    id: separator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: save.top
    margin-bottom: 8

  Button
    id: save
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    width: 90
    height: 21
    text: Save Current

  Button
    id: reset
    anchors.left: save.right
    anchors.bottom: parent.bottom
    margin-left: 6
    width: 75
    height: 21
    text: Defaults

  Button
    id: refresh
    anchors.left: reset.right
    anchors.bottom: parent.bottom
    margin-left: 6
    width: 65
    height: 21
    text: Refresh

  Button
    id: closeButton
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    width: 55
    height: 21
    text: Close
